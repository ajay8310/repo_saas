# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.

# ---- General ---------------------------------------------------------------
APP_NAME="Repo SaaS (dev)"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://reposaaas:reposaaas@localhost:5432/reposaaas

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- AWS -------------------------------------------------------------------
AWS_REGION=ap-south-1
# Leave blank to use IAM role / instance profile in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_BUCKET_NAME=reposaaas-documents-dev
# LocalStack override (development / CI):
# S3_ENDPOINT_URL=http://localhost:4566

# KMS
# KMS_ENDPOINT_URL=http://localhost:4566

# SES
SES_FROM_EMAIL=no-reply@dev.example.com
# SES_ENDPOINT_URL=http://localhost:4566

# SNS
# SNS_ENDPOINT_URL=http://localhost:4566

# ---- JWT -------------------------------------------------------------------
JWT_ALGORITHM=RS256
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents below (preserve newlines with \n or use a .env file).
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
REPLACE_WITH_YOUR_PRIVATE_KEY
-----END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_WITH_YOUR_PUBLIC_KEY
-----END PUBLIC KEY-----"

JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ---- OTP -------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_LENGTH=6

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins; use ["*"] in development only.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_DEFAULT_REQUESTS=10000
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Verification ----------------------------------------------------------
# Public base URL embedded in QR codes on generated documents (no trailing slash).
VERIFICATION_BASE_URL=http://localhost:3000

# ---- ClamAV ----------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
