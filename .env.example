# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.

# ---- General ---------------------------------------------------------------
APP_NAME="Repo SaaS (dev)"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://reposaaas:reposaaas@localhost:5432/reposaaas

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- AWS -------------------------------------------------------------------
AWS_REGION=ap-south-1
# Leave blank to use IAM role / instance profile in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_BUCKET_NAME=reposaaas-documents-dev
# LocalStack override (development / CI):
# S3_ENDPOINT_URL=http://localhost:4566

# KMS
# KMS_ENDPOINT_URL=http://localhost:4566

# SES
SES_FROM_EMAIL=no-reply@dev.example.com
# SES_ENDPOINT_URL=http://localhost:4566

# SNS
# SNS_ENDPOINT_URL=http://localhost:4566

# ---- JWT -------------------------------------------------------------------
JWT_ALGORITHM=RS256
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents below (preserve newlines with \n or use a .env file).
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
REPLACE_WITH_YOUR_PRIVATE_KEY
-----END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_WITH_YOUR_PUBLIC_KEY
-----END PUBLIC KEY-----"

JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ---- OTP -------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_LENGTH=6

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins; use ["*"] in development only.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---- Data vault (field-level PII protection) -------------------------------
# 'local' derives per-tenant keys from VAULT_ROOT_KEY; 'kms' uses AWS KMS.
VAULT_PROVIDER=local
# 32+ bytes, base64 or hex. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# If unset, a key is derived from JWT_PRIVATE_KEY as a bootstrap convenience --
# set it explicitly so vault keys can rotate independently of the JWT keypair.
VAULT_ROOT_KEY=
VAULT_ACTIVE_KEY_ID=k1
VAULT_KMS_KEY_ARN=
# Separate key for deterministic blind indexes. Rotating it invalidates every
# index column and requires a backfill, so it is kept apart from the root key.
VAULT_BLIND_INDEX_KEY=
# Master switch for sealing PII columns. Provision keys and backfill first.
PII_ENCRYPTION_ENABLED=false

# ---- Ledger anchoring ------------------------------------------------------
# 'local' = append-only hash-chained log in this database (tamper-evident, no
# external dependency, but no third-party non-repudiation).
# 'evm' = publish Merkle roots to an EVM chain. 'fabric' is not implemented.
ANCHOR_PROVIDER=local
ANCHOR_RPC_URL=
# Signing service that holds the anchoring key. Keys stay out of this process.
ANCHOR_SIGNER_URL=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_BATCH_MAX_LEAVES=4096

# ---- Consent and data-principal rights (DPDP Act) --------------------------
# Recorded on every consent record so the platform can prove what a data
# principal was shown at the time they agreed. Bump when the notice changes.
CONSENT_NOTICE_VERSION=v1
# 0 = consent persists until withdrawn rather than lapsing on a timer.
CONSENT_DEFAULT_EXPIRY_DAYS=0
# Published escalation contact for grievances.
GRIEVANCE_OFFICER_EMAIL=
# Days an erasure request is held before execution.
ERASURE_GRACE_DAYS=30

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_DEFAULT_REQUESTS=10000
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Verification ----------------------------------------------------------
# Public base URL embedded in QR codes on generated documents (no trailing slash).
VERIFICATION_BASE_URL=http://localhost:3000

# ---- ClamAV ----------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
