# =============================================================================
# Backend image — shared by the API, Celery worker, Celery beat, and migrate
# services. Each ECS service runs this same image with a different container
# command (see deploy/ecs/*.task.json). Build context is the repo root:
#
#   docker build -f Dockerfile.backend -t <ecr>/repo_saas_dev_backend:<tag> .
#
# The default CMD runs the API. The worker, beat, and migrate services do NOT
# need their own Dockerfile — they run this same image and override the
# container command in their ECS task definitions:
#   - worker  -> celery -A app.tasks.celery_app:celery_app worker ...
#   - beat    -> celery -A app.tasks.celery_app:celery_app beat ...
#   - migrate -> alembic upgrade head
# =============================================================================

FROM python:3.12-slim AS base

WORKDIR /app

# System dependencies for weasyprint, psycopg2, and cryptography.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libffi-dev libcairo2 libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better layer caching.
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e "." && pip cache purge

# Copy application source and migrations.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./

# NOTE: Do NOT copy a .env file into the image. Configuration (DATABASE_URL,
# REDIS_URL, S3_BUCKET_NAME, JWT keys, etc.) is injected at runtime by the ECS
# task definition via `environment` and `secrets` (AWS Secrets Manager).
# Baking .env into the image would embed secrets in image layers and lock the
# image to a single environment.

EXPOSE 8000

# Default command runs the API. ECS task definitions override this for the
# worker (celery worker), beat (celery beat), and migrate (alembic upgrade).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
