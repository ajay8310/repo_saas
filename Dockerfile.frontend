# =============================================================================
# Frontend production image — builds the Vite/React app to static files and
# serves them with Nginx. Nginx also proxies /api to the backend API service.
#
# Build context is the REPO ROOT (so both frontend source and this config are
# reachable):
#   docker build -f Dockerfile.frontend -t <ecr>/repo_saas_dev_frontend:<tag> .
#
# The API upstream is configurable at runtime via the API_UPSTREAM env var
# (see deploy/frontend/nginx.conf), so the same image works in any environment.
# =============================================================================

# ---- Stage 1: build the static assets ----
FROM node:20-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ---- Stage 2: serve with Nginx ----
FROM nginx:1.27-alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/frontend/nginx.conf /etc/nginx/templates/default.conf.template

# Default upstream; override per environment in the ECS task definition.
ENV API_UPSTREAM=http://api:8000

EXPOSE 80

# nginx:alpine's entrypoint runs envsubst on /etc/nginx/templates/*.template
# into /etc/nginx/conf.d/ before starting nginx.
CMD ["nginx", "-g", "daemon off;"]
